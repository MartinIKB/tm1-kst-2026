		"query":"SELECT\r\nDISTINCT\r\na.kostenart,\r\na.identifier_planning,\r\na.identifier_planning || ': ' || a.belegtext as Alias,\r\n'Buchung' as Typ,\r\na.belegkopftext as Belegkopftext,\r\na.belegtext as Belegtext,\r\nto_char(a.buchungsdatum,'DD.MM.YYYY') as Buchungsdatum,\r\na.kostenart as Konto\r\nFROM\r\ndtl_kst_belege a\r\nWHERE\r\na.geschaeftsjahr >= '2025'\r\n\r\nUNION\r\n\r\nSELECT DISTINCT \r\nb.kostenart, \r\nb.kostenart || '_Planwert', \r\nb.kostenart || ' Planwert' as Alias,\r\n'Planwert' as Typ,\r\n'' as Belegkopftext,\r\n'' as Belegtext,\r\n'' as Buchungsdatum,\r\n'' as Konto\r\nFROM \r\ndtl_kst_plandaten b where b.geschaeftsjahr >= '2025'\r\n\r\nORDER BY 2, 1 ASC",
